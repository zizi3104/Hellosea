# Set these only in Vercel server-side environment variables or .env.local.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Generate a random 32-byte value. Used to hash client IPs for rate limiting.
RATE_LIMIT_SECRET=
ALLOWED_ORIGINS=https://hellosea.shop,https://www.hellosea.shop
# Optional: international number, digits only, e.g. country code + number.
WHATSAPP_NUMBER=6287861136585

# Supabase project publishable API key for email authentication.
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated verified auth.users UUIDs approved to edit content. Never client controlled.
ADMIN_USER_IDS=
