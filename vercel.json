{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/contact-message.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {"source":"/i18n.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/pricing.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/styles.css","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/our-story","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/ayo-surf","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/photos","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/q-and-a","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/booking-inquiry","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {"source":"/our-story","destination":"/our-story/index.html"},
    {"source":"/our-story/","destination":"/our-story/index.html"},
    {"source":"/ayo-surf","destination":"/ayo-surf/index.html"},
    {"source":"/ayo-surf/","destination":"/ayo-surf/index.html"},
    {"source":"/photos","destination":"/photos/index.html"},
    {"source":"/photos/","destination":"/photos/index.html"},
    {"source":"/q-and-a","destination":"/q-and-a/index.html"},
    {"source":"/q-and-a/","destination":"/q-and-a/index.html"},
    {"source":"/booking-inquiry","destination":"/booking-inquiry/index.html"},
    {"source":"/booking-inquiry/","destination":"/booking-inquiry/index.html"},
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    }
  ]
}